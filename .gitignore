# ==============================================================================
# Smart Care IoT Socket - Git Exclusion Rules (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PlatformIO & Embedded Firmware Build Artifacts
# ------------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
*.hex
*.bin
*.elf
*.o
*.d
*.dblite
*.map
*.lst
*.eep
*.lss
*.sym

# Arduino IDE & ESP-IDF
.build/
.espressif/
build/
sdkconfig
sdkconfig.old

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Test & Coverage Reports
# ------------------------------------------------------------------------------
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml

# ------------------------------------------------------------------------------
# 4. Secrets, Credentials & Local Configs (Strict Protection)
# ------------------------------------------------------------------------------
config.json
*.env
*.env.local
*.env.*.local
.env.*
secrets.h
firebase_credentials.json
serviceAccountKey.json
private_key.pe*
*.pem
*.key
*.cert
*.crt
*.pfx

# ------------------------------------------------------------------------------
# 5. Operating System & Local Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
*.swp
*.swo
*~
*.bak

# IDE & Extensions
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.vsix
