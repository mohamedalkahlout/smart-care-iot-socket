{
  "rules": {
    "sockets": {
      "$socketId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'on' || newData.val() === 'off')"
        },
        "mode": {
          ".validate": "newData.isString() && (newData.val() === 'manual' || newData.val() === 'auto')"
        },
        "deviceType": {
          ".validate": "newData.isString() && (newData.val() === 'cooling' || newData.val() === 'heating' || newData.val() === 'compressor' || newData.val() === 'generic')"
        },
        "minTemp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
        },
        "maxTemp": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 45 && newData.val() >= data.parent().child('minTemp').val()"
        },
        "currentTemp": {
          ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "telemetry": {
      "$socketId": {
        ".read": "auth != null",
        "$entry": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['ts', 'device_id', 'relay_actual', 'mode'])"
        }
      }
    },
    "audit_logs": {
      "$socketId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
